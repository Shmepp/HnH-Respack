{
  "model": {
    "type": "minecraft:composite",
    "models": [
      {
        "type": "minecraft:select",
        "property": "minecraft:custom_model_data",
        "index": 0,
        "cases": [
          {
            "when": "intact",
            "model": {
              "type": "minecraft:model",
              "model": "hnh:block/custom/power_box_intact"
            }
          },
	  {
            "when": "damaged",
            "model": {
              "type": "minecraft:model",
              "model": "hnh:block/custom/power_box_damaged"
            }
          },
	  {
            "when": "broken",
            "model": {
              "type": "minecraft:model",
              "model": "hnh:block/custom/power_box_broken"
            }
          }
        ],
        "fallback": {
          "type": "minecraft:empty"
        }
      }
    ]
  }
}